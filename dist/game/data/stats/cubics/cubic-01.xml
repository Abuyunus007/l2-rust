	<!--
		High Five Storm Cubic.
		Offensive cubic that periodically casts Cubic Strike on valid enemy targets.
		Attribute guide.
		duration: active lifetime in seconds.
		delay: action interval in seconds.
		maxCount: maximum successful actions before the cubic stops or is consumed.
		useUp: when greater than 0, the cubic is removed after reaching maxCount.
		power: base magical power used by offensive cubic calculations.
		selectionMode: skill selection rule used when multiple skills are available.
		targetType: base target routing used by the cubic runtime.
		Levels 8-12 are enchant template levels for High Five cubic skills.
	-->
	<cubic id="1" level="1" slot="1" duration="900" delay="10" maxCount="30" useUp="1" power="282.0" selectionMode="RANDOM" targetType="TARGET">
